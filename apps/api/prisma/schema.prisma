// CertiFlow data model. Each model maps to the user stories in docs/user-stories.md.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CENTRE
  DISTRICT_OFFICER
  QUALITY
  STATE
}

enum BatchStatus {
  DRAFT
  DISTRICT_REVIEW
  QUALITY_REVIEW
  STATE_REVIEW
  APPROVED
  ISSUING
  COMPLETED
  RETURNED
  REJECTED
}

enum ReviewStep {
  DISTRICT
  QUALITY
  STATE
}

enum Decision {
  APPROVE
  REJECT
  SEND_BACK
  WITHDRAW
}

enum CertificateStatus {
  VALID
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model District {
  id      String   @id
  name    String   @unique
  centres Centre[]
  users   User[]
}

model Centre {
  id         String  @id
  name       String
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  batches    Batch[]
}

// The demo "people" (US-2). Officers belong to a district, centre staff to a centre.
model User {
  id         String    @id
  name       String
  role       Role
  districtId String?
  centreId   String?
  district   District? @relation(fields: [districtId], references: [id])
  centre     Centre?   @relation(fields: [centreId], references: [id])
  batches    Batch[]
  approvals  Approval[]
}

model Batch {
  id            String      @id @default(uuid())
  centreId      String
  createdById   String
  name          String
  courseCode    String
  status        BatchStatus @default(DRAFT)
  // Optimistic lock: every transition does UPDATE ... WHERE id = ? AND version = ?
  // so two simultaneous approvals cannot both move the batch forward (US-5).
  version       Int         @default(1)
  // Increases each time the batch is sent back and resubmitted (US-12, decision D4).
  cycle         Int         @default(1)
  // When the batch entered its current step; used for stuck detection (US-11).
  stepEnteredAt DateTime    @default(now())
  escalatedAt   DateTime?
  returnReason  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  centre       Centre        @relation(fields: [centreId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])
  candidates   Candidate[]
  approvals    Approval[]
  certificates Certificate[]

  @@index([centreId])
  @@index([status, stepEnteredAt])
}

model Candidate {
  id          String   @id @default(uuid())
  batchId     String
  fullName    String
  phone       String
  dateOfBirth DateTime @db.Date
  courseCode  String
  score       Int
  createdAt   DateTime @default(now())

  batch       Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  certificate Certificate?

  // A phone number appears once per batch. "One certificate per person per course"
  // is enforced on Certificate (decision D6).
  @@unique([batchId, phone])
}

// One row per decision. The unique key makes "same officer approves twice" a no-op
// and is the first guard for concurrent approvals (US-5).
model Approval {
  id        String     @id @default(uuid())
  batchId   String
  step      ReviewStep
  officerId String
  decision  Decision
  reason    String?
  cycle     Int
  createdAt DateTime   @default(now())

  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  officer User  @relation(fields: [officerId], references: [id])

  // Decision is part of the key so an approval and a later withdrawal can both be kept.
  @@unique([batchId, step, officerId, cycle, decision])
  @@index([batchId])
}

model Certificate {
  id            String            @id @default(uuid())
  // Format PSM-<year>-<6 digits>, built from the certificate_number_seq sequence.
  number        String            @unique
  candidateId   String            @unique
  batchId       String
  holderName    String
  phone         String
  courseCode    String
  status        CertificateStatus @default(VALID)
  issuedAt      DateTime          @default(now())
  pdfPath       String?
  // HMAC of number + holder + course, used to detect tampering (US-9).
  hash          String?
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?

  candidate Candidate @relation(fields: [candidateId], references: [id])
  batch     Batch     @relation(fields: [batchId], references: [id])
  delivery  Delivery?

  // Never two certificates for the same person and course (decision D6).
  @@unique([phone, courseCode])
  @@index([batchId])
}

model Delivery {
  id                String         @id @default(uuid())
  certificateId     String         @unique
  status            DeliveryStatus @default(PENDING)
  attempts          Int            @default(0)
  lastError         String?
  nextAttemptAt     DateTime?
  providerMessageId String?
  updatedAt         DateTime       @updatedAt

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
}

// Transactional outbox (US-7): written in the same transaction as the state change,
// then published to the queue by a relay, so no event is lost if the process crashes.
model OutboxEvent {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt])
}

// Append-only (US-10). A database trigger blocks UPDATE and DELETE.
model AuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actorName  String?
  action     String
  entityType String
  entityId   String
  fromState  String?
  toState    String?
  reason     String?
  requestId  String?

  @@index([entityType, entityId])
  @@index([createdAt])
}
