# Copy to .env. Never commit .env.
POSTGRES_USER=certiflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=certiflow

# Used when you run the api or worker on your laptop (not in Docker).
# Inside Docker, docker-compose.yml overrides these with service names.
DATABASE_URL=postgresql://certiflow:change-me@localhost:5433/certiflow?schema=public
REDIS_URL=redis://localhost:6379
WHATSAPP_URL=http://localhost:4100

PORT=4000
SESSION_SECRET=generate-with-openssl-rand-hex-24-xxxxxxxxxxxxxxxx
CERT_HMAC_SECRET=generate-with-openssl-rand-hex-24-xxxxxxxxxxxxxxxx

# Business rules (see docs/user-stories.md decisions D1 and D7)
QUALITY_REVIEW_MIN_SIZE=50
SLA_DISTRICT_MINUTES=2880
SLA_QUALITY_MINUTES=2880
SLA_STATE_MINUTES=1440

# WhatsApp stand-in behaviour
STUB_FAIL_RATE=0.2
STUB_TIMEOUT_RATE=0.1
STUB_TIMEOUT_MS=15000
